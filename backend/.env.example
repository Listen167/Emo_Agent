LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key
LLM_MODEL=deepseek-chat

AUDIO_EMOTION_WEIGHT=0.65
ASR_LANGUAGE=zh
ASR_DEVICE=cpu
ASR_FORCE_SIMPLIFIED=true

RAG_ENABLED=true
RAG_EMBEDDING_ENABLED=true
RAG_EMBEDDING_MODEL_DIR=/app/models/bge-small-zh-v1.5
RAG_KEYWORD_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.65

TTS_ENABLED=true
TTS_PROVIDER=tencent
TTS_LOCAL_PROVIDER=edge
TTS_VOICE=zh-CN-YunxiNeural
XIAOXI_TTS_VOICE=
TTS_ALLOW_WINDOWS_FALLBACK=True

TENCENTCLOUD_SECRET_ID=your_tencent_secret_id
