TENCENTCLOUD_APP_ID=your_tencent_app_id
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=101016
TENCENT_TTS_FAST_VOICE_TYPE=
TENCENT_TTS_CODEC=mp3
TENCENT_TTS_SAMPLE_RATE=16000
TENCENT_TTS_PRIMARY_LANGUAGE=1
TENCENT_TTS_MODEL_TYPE=1
