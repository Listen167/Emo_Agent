TENCENT_TTS_VOLUME=0
TENCENT_TTS_SPEED=0
TENCENT_TTS_SEGMENT_RATE=0
TENCENT_TTS_ENABLE_EMOTION=false
TENCENT_TTS_EMOTION_INTENSITY=100
TENCENT_TTS_MAX_CHARS=150
TENCENT_STREAM_TTS_ENABLED=true
TENCENT_STREAM_TTS_VOICE_TYPE=101016
TENCENT_STREAM_TTS_CODEC=mp3
TENCENT_STREAM_TTS_SAMPLE_RATE=16000
TENCENT_STREAM_TTS_EXPIRED_SECONDS=86400

KOKORO_MODEL_DIR=D:\PragramFile\VScode\Emo_Agent\models\kokoro-zh
